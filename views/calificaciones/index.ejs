<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePage }) %>

    <div class="app-main">
      <%- include('../partials/header') %>

      <main class="content-area">
        <section class="page-heading">
          <div>
            <p class="page-kicker mb-2">Gestion academica</p>
            <h2 class="page-title">Calificaciones</h2>
            <p class="page-description">Registro de notas para alumnos inscritos en cursos activos.</p>
          </div>
          <a href="/calificaciones/nueva" class="btn btn-primary">Nueva Calificacion</a>
        </section>

        <% if (successMessage) { %>
          <div class="alert alert-success border-0 shadow-sm mb-4" role="alert">
            <%= successMessage %>
          </div>
        <% } %>

        <% if (errorMessage) { %>
          <div class="alert alert-warning border-0 shadow-sm mb-4" role="alert">
            <strong>Atencion:</strong> <%= errorMessage %>
          </div>
        <% } %>

        <section class="data-panel">
          <div class="table-responsive">
            <table class="table table-hover align-middle data-table mb-0">
              <thead>
                <tr>
                  <th>Alumno</th>
                  <th>Curso</th>
                  <th>Parcial</th>
                  <th>Final</th>
                  <th>Promedio</th>
                  <th>Resultado</th>
                  <th>Observaciones</th>
                  <th class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% if (calificaciones.length === 0) { %>
                  <tr>
                    <td colspan="8" class="text-center text-secondary py-4">No hay calificaciones registradas.</td>
                  </tr>
                <% } %>

                <% calificaciones.forEach((calificacion) => { %>
                  <tr>
                    <td>
                      <div class="fw-semibold"><%= calificacion.alumno_nombre %></div>
                      <small class="text-secondary">Carnet: <%= calificacion.alumno_carnet %></small>
                    </td>
                    <td>
                      <div class="fw-semibold"><%= calificacion.curso_nombre %></div>
                      <small class="text-secondary">Codigo: <%= calificacion.curso_codigo %></small>
                    </td>
                    <td><%= Number(calificacion.nota_parcial).toFixed(2) %></td>
                    <td><%= Number(calificacion.nota_final).toFixed(2) %></td>
                    <td class="fw-semibold"><%= Number(calificacion.promedio).toFixed(2) %></td>
                    <td>
                      <span class="badge <%= calificacion.resultado === 'Aprobado' ? 'text-bg-success' : 'text-bg-danger' %>">
                        <%= calificacion.resultado %>
                      </span>
                    </td>
                    <td><%= calificacion.observaciones || 'Sin observaciones' %></td>
                    <td>
                      <div class="action-group">
                        <a href="/calificaciones/editar/<%= calificacion.id_calificacion %>" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form action="/calificaciones/eliminar/<%= calificacion.id_calificacion %>" method="POST" onsubmit="return confirm('Desea eliminar esta calificacion?');">
                          <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>
</body>
</html>
