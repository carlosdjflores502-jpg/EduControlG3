<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePage }) %>

    <div class="app-main">
      <%- include('../partials/header') %>

      <main class="content-area">
        <section class="page-heading">
          <div>
            <p class="page-kicker mb-2">Gestion academica</p>
            <h2 class="page-title">Alumnos</h2>
            <p class="page-description">Administracion de alumnos registrados en EduControl G3.</p>
          </div>
          <a href="/alumnos/nuevo" class="btn btn-primary">Nuevo Alumno</a>
        </section>

        <% if (successMessage) { %>
          <div class="alert alert-success border-0 shadow-sm mb-4" role="alert">
            <%= successMessage %>
          </div>
        <% } %>

        <% if (errorMessage) { %>
          <div class="alert alert-warning border-0 shadow-sm mb-4" role="alert">
            <strong>Atencion:</strong> <%= errorMessage %>
          </div>
        <% } %>

        <section class="data-panel">
          <div class="table-responsive">
            <table class="table table-hover align-middle data-table mb-0">
              <thead>
                <tr>
                  <th>Carnet</th>
                  <th>Nombre</th>
                  <th>Correo</th>
                  <th>Telefono</th>
                  <th>Carrera</th>
                  <th>Estado</th>
                  <th class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% if (alumnos.length === 0) { %>
                  <tr>
                    <td colspan="7" class="text-center text-secondary py-4">No hay alumnos registrados.</td>
                  </tr>
                <% } %>

                <% alumnos.forEach((alumno) => { %>
                  <tr>
                    <td class="fw-semibold"><%= alumno.carnet %></td>
                    <td><%= alumno.nombre %> <%= alumno.apellido %></td>
                    <td><%= alumno.correo %></td>
                    <td><%= alumno.telefono || 'Sin telefono' %></td>
                    <td><%= alumno.carrera %></td>
                    <td>
                      <span class="badge <%= alumno.estado === 'Activo' ? 'text-bg-success' : 'text-bg-secondary' %>">
                        <%= alumno.estado %>
                      </span>
                    </td>
                    <td>
                      <div class="action-group">
                        <a href="/alumnos/editar/<%= alumno.id_alumno %>" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form action="/alumnos/eliminar/<%= alumno.id_alumno %>" method="POST" onsubmit="return confirm('Desea eliminar este alumno?');">
                          <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>
</body>
</html>
