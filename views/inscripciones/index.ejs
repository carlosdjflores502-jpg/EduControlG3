<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePage }) %>

    <div class="app-main">
      <%- include('../partials/header') %>

      <main class="content-area">
        <section class="page-heading">
          <div>
            <p class="page-kicker mb-2">Gestion academica</p>
            <h2 class="page-title">Inscripciones</h2>
            <p class="page-description">Asignacion de alumnos activos a cursos activos registrados en EduControl G3.</p>
          </div>
          <a href="/inscripciones/nueva" class="btn btn-primary">Nueva Inscripcion</a>
        </section>

        <% if (successMessage) { %>
          <div class="alert alert-success border-0 shadow-sm mb-4" role="alert">
            <%= successMessage %>
          </div>
        <% } %>

        <% if (errorMessage) { %>
          <div class="alert alert-warning border-0 shadow-sm mb-4" role="alert">
            <strong>Atencion:</strong> <%= errorMessage %>
          </div>
        <% } %>

        <section class="data-panel">
          <div class="table-responsive">
            <table class="table table-hover align-middle data-table mb-0">
              <thead>
                <tr>
                  <th>Alumno</th>
                  <th>Curso</th>
                  <th>Fecha</th>
                  <th>Estado</th>
                  <th class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% if (inscripciones.length === 0) { %>
                  <tr>
                    <td colspan="5" class="text-center text-secondary py-4">No hay inscripciones registradas.</td>
                  </tr>
                <% } %>

                <% inscripciones.forEach((inscripcion) => { %>
                  <tr>
                    <td>
                      <div class="fw-semibold"><%= inscripcion.alumno_nombre %></div>
                      <small class="text-secondary">Carnet: <%= inscripcion.alumno_carnet %></small>
                    </td>
                    <td>
                      <div class="fw-semibold"><%= inscripcion.curso_nombre %></div>
                      <small class="text-secondary">Codigo: <%= inscripcion.curso_codigo %></small>
                    </td>
                    <td><%= new Date(inscripcion.fecha_inscripcion).toISOString().slice(0, 10) %></td>
                    <td>
                      <span class="badge <%= inscripcion.estado === 'Activa' ? 'text-bg-success' : (inscripcion.estado === 'Cancelada' ? 'text-bg-danger' : 'text-bg-primary') %>">
                        <%= inscripcion.estado %>
                      </span>
                    </td>
                    <td>
                      <div class="action-group">
                        <a href="/inscripciones/editar/<%= inscripcion.id_inscripcion %>" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form action="/inscripciones/eliminar/<%= inscripcion.id_inscripcion %>" method="POST" onsubmit="return confirm('Desea eliminar esta inscripcion?');">
                          <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>
</body>
</html>
