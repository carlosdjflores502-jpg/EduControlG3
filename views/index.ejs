<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('partials/sidebar', { activePage }) %>

    <div class="app-main">
      <%- include('partials/header') %>

      <main class="content-area">
        <section class="page-heading">
          <div>
            <p class="page-kicker mb-2">Panel administrativo academico</p>
            <h2 class="page-title">Dashboard</h2>
            <p class="page-description">Resumen general con informacion real registrada en MySQL.</p>
          </div>
          <span class="status-pill <%= errorMessage ? 'status-pill-warning' : '' %>">
            <%= errorMessage ? 'Datos no disponibles' : 'Datos desde MySQL' %>
          </span>
        </section>

        <% if (errorMessage) { %>
          <div class="alert alert-warning border-0 shadow-sm mb-4" role="alert">
            <strong>Atencion:</strong> <%= errorMessage %>
          </div>
        <% } %>

        <section class="row g-3 g-xl-4">
          <div class="col-12 col-sm-6 col-xl-3">
            <article class="metric-card metric-card-blue">
              <div class="metric-top">
                <span class="metric-icon">A</span>
                <span class="metric-tag">Alumnos</span>
              </div>
              <p class="metric-label">Total de alumnos</p>
              <h3><%= counts.alumnos %></h3>
            </article>
          </div>

          <div class="col-12 col-sm-6 col-xl-3">
            <article class="metric-card metric-card-green">
              <div class="metric-top">
                <span class="metric-icon">C</span>
                <span class="metric-tag">Cursos</span>
              </div>
              <p class="metric-label">Total de cursos</p>
              <h3><%= counts.cursos %></h3>
            </article>
          </div>

          <div class="col-12 col-sm-6 col-xl-3">
            <article class="metric-card metric-card-gold">
              <div class="metric-top">
                <span class="metric-icon">I</span>
                <span class="metric-tag">Inscripciones</span>
              </div>
              <p class="metric-label">Total de inscripciones</p>
              <h3><%= counts.inscripciones %></h3>
            </article>
          </div>

          <div class="col-12 col-sm-6 col-xl-3">
            <article class="metric-card metric-card-red">
              <div class="metric-top">
                <span class="metric-icon">N</span>
                <span class="metric-tag">Notas</span>
              </div>
              <p class="metric-label">Total de calificaciones</p>
              <h3><%= counts.calificaciones %></h3>
            </article>
          </div>
        </section>

        <section class="dashboard-panel mt-4">
          <div>
            <h3 class="panel-title">Estado del sistema</h3>
            <p class="panel-text">La estructura visual esta lista para integrar los modulos CRUD de alumnos, cursos, inscripciones y calificaciones.</p>
          </div>
          <div class="panel-badge">MVC + Bootstrap 5</div>
        </section>
      </main>

      <%- include('partials/footer') %>
    </div>
  </div>
</body>
</html>
