<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePage }) %>

    <div class="app-main">
      <%- include('../partials/header') %>

      <main class="content-area">
        <section class="page-heading">
          <div>
            <p class="page-kicker mb-2">Gestion academica</p>
            <h2 class="page-title">Nuevo Curso</h2>
            <p class="page-description">Registra un curso con su informacion academica principal.</p>
          </div>
          <a href="/cursos" class="btn btn-outline-secondary">Volver</a>
        </section>

        <% if (errors.length > 0) { %>
          <div class="alert alert-warning border-0 shadow-sm mb-4" role="alert">
            <strong>Revisa el formulario:</strong>
            <ul class="mb-0 mt-2">
              <% errors.forEach((error) => { %>
                <li><%= error %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <section class="form-panel">
          <form action="/cursos/nuevo" method="POST" class="row g-3">
            <%- include('form', { curso, submitText: 'Guardar Curso' }) %>
          </form>
        </section>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>
</body>
</html>
