<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePage }) %>

    <div class="app-main">
      <%- include('../partials/header') %>

      <main class="content-area">
        <section class="page-heading">
          <div>
            <p class="page-kicker mb-2">Gestion academica</p>
            <h2 class="page-title">Cursos</h2>
            <p class="page-description">Administracion de cursos registrados en EduControl G3.</p>
          </div>
          <a href="/cursos/nuevo" class="btn btn-primary">Nuevo Curso</a>
        </section>

        <% if (successMessage) { %>
          <div class="alert alert-success border-0 shadow-sm mb-4" role="alert">
            <%= successMessage %>
          </div>
        <% } %>

        <% if (errorMessage) { %>
          <div class="alert alert-warning border-0 shadow-sm mb-4" role="alert">
            <strong>Atencion:</strong> <%= errorMessage %>
          </div>
        <% } %>

        <section class="data-panel">
          <div class="table-responsive">
            <table class="table table-hover align-middle data-table mb-0">
              <thead>
                <tr>
                  <th>Codigo</th>
                  <th>Curso</th>
                  <th>Creditos</th>
                  <th>Catedratico</th>
                  <th>Horario</th>
                  <th>Estado</th>
                  <th class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% if (cursos.length === 0) { %>
                  <tr>
                    <td colspan="7" class="text-center text-secondary py-4">No hay cursos registrados.</td>
                  </tr>
                <% } %>

                <% cursos.forEach((curso) => { %>
                  <tr>
                    <td class="fw-semibold"><%= curso.codigo %></td>
                    <td>
                      <div class="fw-semibold"><%= curso.nombre %></div>
                      <small class="text-secondary"><%= curso.descripcion || 'Sin descripcion' %></small>
                    </td>
                    <td><%= curso.creditos %></td>
                    <td><%= curso.catedratico %></td>
                    <td><%= curso.horario || 'Sin horario' %></td>
                    <td>
                      <span class="badge <%= curso.estado === 'Activo' ? 'text-bg-success' : 'text-bg-secondary' %>">
                        <%= curso.estado %>
                      </span>
                    </td>
                    <td>
                      <div class="action-group">
                        <a href="/cursos/editar/<%= curso.id_curso %>" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form action="/cursos/eliminar/<%= curso.id_curso %>" method="POST" onsubmit="return confirm('Desea eliminar este curso?');">
                          <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>
</body>
</html>
