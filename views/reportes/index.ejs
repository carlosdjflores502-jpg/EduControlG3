<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePage }) %>

    <div class="app-main">
      <%- include('../partials/header') %>

      <main class="content-area">
        <section class="page-heading">
          <div>
            <p class="page-kicker mb-2">Analisis academico</p>
            <h2 class="page-title">Reportes</h2>
            <p class="page-description">Indicadores basicos generados con informacion real registrada en MySQL.</p>
          </div>
          <span class="status-pill <%= errorMessage ? 'status-pill-warning' : '' %>">
            <%= errorMessage ? 'Datos no disponibles' : 'Datos actualizados' %>
          </span>
        </section>

        <% if (errorMessage) { %>
          <div class="alert alert-warning border-0 shadow-sm mb-4" role="alert">
            <strong>Atencion:</strong> <%= errorMessage %>
          </div>
        <% } %>

        <section class="row g-3 g-xl-4 mb-4">
          <div class="col-12 col-md-4">
            <article class="metric-card metric-card-green">
              <div class="metric-top">
                <span class="metric-icon">A</span>
                <span class="metric-tag">Resultados</span>
              </div>
              <p class="metric-label">Total de aprobados</p>
              <h3><%= reportes.resumenResultados.total_aprobados %></h3>
            </article>
          </div>

          <div class="col-12 col-md-4">
            <article class="metric-card metric-card-red">
              <div class="metric-top">
                <span class="metric-icon">R</span>
                <span class="metric-tag">Resultados</span>
              </div>
              <p class="metric-label">Total de reprobados</p>
              <h3><%= reportes.resumenResultados.total_reprobados %></h3>
            </article>
          </div>

          <div class="col-12 col-md-4">
            <article class="metric-card metric-card-blue">
              <div class="metric-top">
                <span class="metric-icon">P</span>
                <span class="metric-tag">General</span>
              </div>
              <p class="metric-label">Promedio general</p>
              <h3><%= Number(reportes.resumenResultados.promedio_general).toFixed(2) %></h3>
            </article>
          </div>
        </section>

        <section class="report-section">
          <div class="report-section-header">
            <div>
              <h3 class="panel-title">Resumen de alumnos por curso</h3>
              <p class="panel-text">Cantidad de alumnos inscritos por cada curso registrado.</p>
            </div>
          </div>

          <div class="data-panel">
            <div class="table-responsive">
              <table class="table table-hover align-middle data-table mb-0">
                <thead>
                  <tr>
                    <th>Codigo</th>
                    <th>Curso</th>
                    <th>Catedratico</th>
                    <th>Total de alumnos inscritos</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (reportes.alumnosPorCurso.length === 0) { %>
                    <tr>
                      <td colspan="4" class="text-center text-secondary py-4">No hay cursos registrados para mostrar este reporte.</td>
                    </tr>
                  <% } %>

                  <% reportes.alumnosPorCurso.forEach((curso) => { %>
                    <tr>
                      <td class="fw-semibold"><%= curso.codigo %></td>
                      <td><%= curso.nombre %></td>
                      <td><%= curso.catedratico %></td>
                      <td><%= curso.total_alumnos %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section class="report-section mt-4">
          <div class="report-section-header">
            <div>
              <h3 class="panel-title">Reporte de calificaciones por curso</h3>
              <p class="panel-text">Notas registradas por alumno y curso.</p>
            </div>
          </div>

          <div class="data-panel">
            <div class="table-responsive">
              <table class="table table-hover align-middle data-table mb-0">
                <thead>
                  <tr>
                    <th>Alumno</th>
                    <th>Carnet</th>
                    <th>Curso</th>
                    <th>Parcial</th>
                    <th>Final</th>
                    <th>Promedio</th>
                    <th>Resultado</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (reportes.calificacionesPorCurso.length === 0) { %>
                    <tr>
                      <td colspan="7" class="text-center text-secondary py-4">No hay calificaciones registradas para mostrar este reporte.</td>
                    </tr>
                  <% } %>

                  <% reportes.calificacionesPorCurso.forEach((calificacion) => { %>
                    <tr>
                      <td class="fw-semibold"><%= calificacion.alumno %></td>
                      <td><%= calificacion.carnet %></td>
                      <td><%= calificacion.curso %></td>
                      <td><%= Number(calificacion.nota_parcial).toFixed(2) %></td>
                      <td><%= Number(calificacion.nota_final).toFixed(2) %></td>
                      <td class="fw-semibold"><%= Number(calificacion.promedio).toFixed(2) %></td>
                      <td>
                        <span class="badge <%= calificacion.resultado === 'Aprobado' ? 'text-bg-success' : 'text-bg-danger' %>">
                          <%= calificacion.resultado %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>
</body>
</html>
